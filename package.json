  "dependencies": { "@vitejs/plugin-react": "latest", "idb": "latest", "lucide-react": "latest", "react": "latest", "react-dom": "latest", "vite": "latest", "vite-plugin-pwa": "latest" },
  "devDependencies": { "@eslint/js": "latest", "@playwright/test": "latest", "@types/node": "latest", "@types/react": "latest", "@types/react-dom": "latest", "eslint": "latest", "eslint-plugin-react-hooks": "latest", "eslint-plugin-react-refresh": "latest", "jsdom": "latest", "tsx": "latest", "typescript": "latest", "typescript-eslint": "latest", "vitest": "latest" }
}
